{
  "info": {
    "name": "RealMente API",
    "description": "Coleção de requisições para testar a API RealMente com Postman e Newman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Usuários",
      "item": [
        {
          "name": "Criar usuário",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"João Silva\",\n  \"email\": \"joao.silva@example.com\",\n  \"senha\": \"senha123\",\n  \"condicao\": \"Ativo\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            }
          }
        },
        {
          "name": "Listar usuários",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            }
          }
        },
        {
          "name": "Buscar usuário por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/usuarios/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                ":id"
              ]
            }
          }
        },
        {
          "name": "Atualizar usuário",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"João Souza\",\n  \"email\": \"joao.souza@example.com\",\n  \"senha\": \"novaSenha123\",\n  \"condicao\": \"Ativo\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                ":id"
              ]
            }
          }
        },
        {
          "name": "Deletar usuário",
